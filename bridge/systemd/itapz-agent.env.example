# /etc/itapz-agent.env  —  chmod 600 (contiene la password RCON)
SITE_URL=http://localhost:3000
API_KEY=
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=LA_TUA_PASSWORD_RCON
PZ_SERVICE=pzserver
PZ_CONFIG=/home/administrator/Zomboid/Server/servertest.ini
POLL_SECONDS=3

# Riavvio automatico per mod da aggiornare (checkModsNeedUpdate)
MOD_CHECK_MINUTES=10
MOD_RESTART_MINUTES=5
# regex sul positivo e sul negativo dell'output del comando
MOD_NEED_UPDATE_RE=(?i)need update
MOD_NO_UPDATE_RE=(?i)no mods? need update
