# Agent ITAPz: esegue sulla VPS i comandi accodati dal pannello admin
# (RCON, start/stop/restart, lettura/scrittura del .ini).
#
#   sudo cp itapz-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now itapz-agent
#
# I segreti stanno in /etc/itapz-agent.env (chmod 600), non qui.

[Unit]
Description=ITAPz server control agent
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/itapz-agent.env
ExecStart=/usr/local/bin/itapz-agent.py --loop
Restart=always
RestartSec=10
# L'agent gira senza privilegi: possiede i file del server (per leggere e
# scrivere il .ini) e via sudoers puo' fare solo start/stop/restart dell'unita'.
# Deve combaciare con l'utente indicato in /etc/sudoers.d/itapz.
User=administrator
Group=administrator
# necessario perche' sudo possa elevare per il solo systemctl consentito
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
