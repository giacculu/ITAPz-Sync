# Bridge ITAPz: legge il log del server e manda i dati al sito.
#
#   sudo cp itapz-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now itapz-bridge
#
# Sostituisce la riga di cron. Da cron il minimo e' un minuto: un'uccisione
# poteva restare ferma nel log fino a sessanta secondi prima di arrivare al
# sito, e con lei l'achievement e l'annuncio su Discord. Come servizio il giro
# e' ogni due secondi.
#
# La riga di cron va tolta, o i due si contendono il segnalibro di lettura e
# ognuno si mangia i dati dell'altro. Attenzione: il file /etc/cron.d/itapz
# contiene anche altre righe (premi, allarmi, backup), quindi si toglie la
# riga, non il file:
#   sudo sed -i '/itapz-bridge/d' /etc/cron.d/itapz
#   sudo crontab -l 2>/dev/null | grep -v itapz-bridge | sudo crontab -
#   sudo sed -i '/itapz-bridge/d' /etc/crontab
# Poi si verifica che non sia rimasta da nessuna parte:
#   sudo grep -rn itapz-bridge /etc/cron* /var/spool/cron 2>/dev/null
#
# I segreti stanno in /etc/itapz-bridge.env (chmod 600), non qui:
#   ZOMBOID_DIR=/home/administrator/Zomboid
#   SITE_URL=http://localhost:3000
#   API_KEY=la_tua_SYNC_API_KEY

[Unit]
Description=ITAPz log bridge
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/itapz-bridge.env
ExecStart=/usr/local/bin/itapz-bridge.sh --loop
Restart=always
RestartSec=10
# Legge il log del server e scrive i propri segnalibri nella cartella Zomboid:
# stesso utente che possiede quei file.
User=administrator
Group=administrator

[Install]
WantedBy=multi-user.target
